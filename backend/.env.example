# Valeurs par defaut pour le conteneur Docker local (docker-compose.yml) :
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/nom_de_la_base
SPRING_DATASOURCE_USERNAME=utilisateur
SPRING_DATASOURCE_PASSWORD=motdepasse
JWT_SECRET=<generate a random 256-bit+ secret, e.g. `openssl rand -base64 64`>
URL_FRONT=http://localhost:3000

# En prod, pointer SPRING_DATASOURCE_URL/SPRING_DATASOURCE_USERNAME/SPRING_DATASOURCE_PASSWORD vers la vraie base (ex: Neon) au lieu de Docker.
